#!/usr/bin/env node
const { run } = require('./create-plugin')
const args = process.argv.slice(2)

if (args[0] === 'create-plugin') {
  run(args[1])
} else if (args[0] === 'dev') {
  const { startDev } = require('./dev-mode')
  startDev(args[1] || process.cwd())
} else {
  console.log(`
OpenBox CLI v0.5.0
用法:
  openbox create-plugin <名称>    创建一个新插件项目
  openbox dev [路径]              启动插件开发模式
  `)
}
