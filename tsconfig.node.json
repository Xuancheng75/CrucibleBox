{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["shared/**/*.ts", "packages/openbox-rpc/src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
