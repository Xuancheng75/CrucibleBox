{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@database/*": ["./database/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "database/**/*.ts",
    "plugin-system/**/*.ts",
    "shared/**/*.ts",
    "plugins/unienv/src/artifact-integrity.ts",
    "plugins/unienv/src/trusted-service.ts",
    "plugins/unienv/src/combo.ts",
    "plugins/unienv/src/path-policy.ts",
    "plugins/unienv/src/process-runner.ts",
    "plugins/unienv/src/protocol.ts",
    "plugins/unienv/src/task-manager.ts",
    "plugins/unienv/src/tools/**/*.ts",
    "electron.vite.config.ts"
  ],
  "exclude": ["node_modules", "out", "dist"]
}
