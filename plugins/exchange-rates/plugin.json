{
  "name": "exchange-rates",
  "version": "0.3.0",
  "displayName": "旧版汇率（只读兼容）",
  "description": "旧汇率收藏和数据导出入口；常用换算已合并到“笔记与效率”。",
  "author": "CrucibleBox",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "manifestVersion": 2,
  "backendApiVersion": 2,
  "rendererApiVersion": 2,
  "permissions": ["network:fetch", "storage:read", "storage:write"],
  "config": {
    "baseCurrency": {
      "type": "select",
      "label": "基准货币",
      "description": "默认基准货币",
      "default": "USD",
      "options": [
        { "label": "美元 USD", "value": "USD" },
        { "label": "人民币 CNY", "value": "CNY" },
        { "label": "欧元 EUR", "value": "EUR" },
        { "label": "日元 JPY", "value": "JPY" },
        { "label": "英镑 GBP", "value": "GBP" }
      ],
      "required": false
    }
  }
}
