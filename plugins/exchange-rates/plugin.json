{
  "name": "exchange-rates",
  "version": "0.4.0-beta.2",
  "displayName": "汇率与单位换算",
  "description": "实时汇率、币种收藏与长度、重量、温度单位换算。",
  "category": "效率工具",
  "tags": ["汇率", "单位换算", "货币"],
  "keywords": ["外币", "长度", "重量", "温度"],
  "author": "CrucibleBox",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "manifestVersion": 2,
  "backendApiVersion": 2,
  "rendererApiVersion": 2,
  "permissions": ["network:fetch", "storage:read", "storage:write"],
  "config": {
    "baseCurrency": {
      "type": "select",
      "label": "基准货币",
      "description": "默认基准货币",
      "default": "USD",
      "options": [
        { "label": "美元 USD", "value": "USD" },
        { "label": "人民币 CNY", "value": "CNY" },
        { "label": "欧元 EUR", "value": "EUR" },
        { "label": "日元 JPY", "value": "JPY" },
        { "label": "英镑 GBP", "value": "GBP" }
      ],
      "required": false
    }
  }
}
