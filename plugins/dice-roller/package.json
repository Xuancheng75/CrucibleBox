{
  "name": "cruciblebox-plugin-diceroller",
  "version": "0.1.6",
  "private": true,
  "description": "Dice and random number plugin for OpenBox",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node ../../scripts/clean-plugin-dist.mjs",
    "build": "npm run clean && tsc && node ../../scripts/build-plugin-renderer.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm test && npm run build",
    "watch": "node ../../scripts/build-plugin-renderer.mjs . --watch"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
