{
  "id": "turntable",
  "version": "0.5.0-alpha.1",
  "displayName": "随机决策",
  "description": "转盘权重抽取、转盘动画、结果历史与骰子投掷。",
  "author": "CrucibleBox",
  "category": "效率工具",
  "manifestVersion": 5,
  "sdkApiVersion": 5,
  "wireVersion": 3,
  "dataSchemaVersion": 1,
  "renderer": "dist/renderer.js",
  "permissions": ["storage:read", "storage:write", "notification"],
  "config": {
    "themeColor": {
      "type": "string",
      "label": "主题色",
      "description": "转盘的主色调",
      "default": "#1677ff",
      "required": false
    },
    "spinDuration": {
      "type": "number",
      "label": "旋转持续时间（秒）",
      "description": "转盘旋转动画的持续时间",
      "default": 4,
      "required": false
    }
  }
}
