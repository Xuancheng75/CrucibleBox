{
  "name": "document-engine",
  "version": "0.12.0-alpha.1",
  "private": true,
  "description": "CrucibleBox 文档与知识库插件 — 综合文件处理、OCR 与 RAG 预处理",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build-next.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@cruciblebox/plugin-ui": "file:vendor/plugin-ui",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@cruciblebox/next-api": "file:vendor/next-api"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "adm-zip": "0.6.0"
  }
}
