{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"],
    "declaration": false,
    "sourceMap": false,
    "newLine": "lf",
    "noEmit": true,
    "paths": {
      "@cruciblebox/next-api": ["./vendor/next-api/src/index.d.ts"],
      "@cruciblebox/plugin-ui": ["./vendor/plugin-ui/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "src/main.ts"]
}
