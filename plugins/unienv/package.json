{
  "name": "unienv",
  "version": "0.5.7",
  "private": true,
  "description": "UniEnv - 一键式开发环境配置工具",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node ../../scripts/clean-plugin-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ../../scripts/build-plugin-renderer.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm test && npm run build",
    "watch": "node ../../scripts/build-plugin-renderer.mjs . --watch"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
