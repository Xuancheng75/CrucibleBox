{
  "name": "cruciblebox-plugin-diary",
  "version": "0.7.0-alpha.1",
  "private": true,
  "description": "Diary and notes plugin for CrucibleBox",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build-next.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "katex": "^0.16.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "@cruciblebox/next-api": "file:vendor/next-api"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "adm-zip": "0.6.0",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
