{
  "id": "theme-manager",
  "version": "0.4.0-alpha.1",
  "displayName": "主题管理",
  "description": "提供亮色、深色、科幻面板、像素街机、陶土工坊和纸张编辑六种内置主题，并支持自定义配色。",
  "author": "CrucibleBox",
  "manifestVersion": 5,
  "sdkApiVersion": 5,
  "wireVersion": 3,
  "dataSchemaVersion": 1,
  "renderer": "dist/renderer.js",
  "permissions": [
    "theme:read",
    "theme:write",
    "storage:read",
    "storage:write",
    "browser:downloads"
  ],
  "config": {
    "customThemes": {
      "type": "string",
      "label": "自定义主题",
      "description": "已保存的自定义主题（JSON 数组）",
      "default": "[]",
      "required": false
    }
  }
}
