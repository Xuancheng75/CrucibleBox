{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrucibleBox",
  "version": "1.9.13",
  "identifier": "com.cruciblebox.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "",
    "frontendDist": "../tauri-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrucibleBox",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src 'self' http://cruciblebox-plugin.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/openbox-neon-32.png",
      "icons/openbox-neon-128.png",
      "icons/openbox-neon-256.png",
      "icons/openbox-neon-512.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "externalBin": ["binaries/cruciblebox-plugin-host"],
    "resources": {
      "../out/plugin-frame/runtime.js": "out/plugin-frame/runtime.js"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExOTNCREQ1RUIzQTBCRTQKUldUa0N6cnIxYjJURWE2RXVqMGI1Q1hSUDFHUm9mNWhKVzNOVmdQWjJKNi9LeGEwaUpsOTJaZlYK",
      "endpoints": [
        "https://github.com/Xuancheng75/CrucibleBox/releases/download/tauri-latest/latest.json"
      ]
    }
  }
}
